{
  "name": "@all41-dev/server.types",
  "version": "1.4.0-beta.9",
  "description": "",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all41-dev/server.types.git"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/**",
    "test": "mocha -r ts-node/register src/**/*.spec.ts",
    "preversion": "run-p test lint build",
    "postversion": "git push && git push --tags && node -e \"const v=require('./package.json').version;const t=v.includes('beta')?'beta':v.includes('alpha')?'alpha':'latest';require('child_process').execSync('npm publish --access public --tag '+t,{stdio:'inherit'})\"",
    "version:alpha": "npm version prerelease --preid=alpha",
    "version:beta": "npm version prerelease --preid=beta",
    "release:beta": "git push && git push --tags && npm publish --access public --tag beta",
    "release": "git push && git push --tags && npm publish --access public"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/luxon": "^3.7.2",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mocha": "^11.3.0",
    "npm-run-all2": "^9.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "volta": {
    "node": "26.5.0"
  }
}
